# ==============================================================================
# ZAROORAT (KotaMitra) Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Do NOT commit real secrets or production credentials to version control.
# - In staging and production, set NODE_ENV=production to disable development OTP.
# - Replace ALL placeholder values before running in staging/production.
# ==============================================================================

# Environment mode: 'development', 'staging', or 'production'
# Setting NODE_ENV=production automatically disables fixed '123456' development OTP
NODE_ENV=production

# Server listening port (Render/Railway sets this automatically via $PORT)
PORT=4100

# Administrative portal credentials (PLACEHOLDERS ONLY - MUST BE CHANGED)
# In production, the server will refuse to start if these match default/empty values.
KOTAMITRA_ADMIN_EMAIL=admin@your-verified-domain.com
KOTAMITRA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_MIN_16_CHARS

# Persistent storage paths (Relative or Absolute)
# For Render persistent disk mounted at /var/data or /app/database/data:
KOTAMITRA_DATA_FILE=database/data/businesses.json
KOTAMITRA_SESSIONS_FILE=database/data/sessions.json

# Demo Mode toggle: must be 'false' in staging and production
KOTAMITRA_DEMO_MODE=false
